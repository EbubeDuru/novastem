# Supabase — from your project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=     # server-only, never expose to client
SUPABASE_PROJECT_ID=

# Anthropic — for the discovery agent
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron auth — set this to a random string, and configure the same value
# in Vercel's cron header / secret so /api/cron/discover can't be hit publicly
CRON_SECRET=
